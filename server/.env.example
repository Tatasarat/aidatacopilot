# ── Required ────────────────────────────────────────────────
# Neon / Postgres connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Where the React app is hosted (comma-separate several origins if needed)
CLIENT_URL=http://localhost:3000

# ── Email (Brevo HTTP API) ──────────────────────────────────
BREVO_API_KEY=
# Must be a sender you verified in Brevo, ideally on your own domain (e.g. reports@yourdomain.com)
BREVO_SENDER_EMAIL=
APP_NAME=ShopPulse AI

# ── AI (optional: without it, answers use built-in rules + templates) ──
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# ── Payments (optional until you charge) ────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Weekly report job ───────────────────────────────────────
# Set to "true" to run the built-in Monday 9:00 IST scheduler (needs an always-on server).
ENABLE_SCHEDULER=false
# Secret for POST /api/jobs/weekly-report, so an external cron service can trigger it
CRON_SECRET=

# ── Misc ────────────────────────────────────────────────────
PORT=10000
NODE_ENV=development
BCRYPT_ROUNDS=12
